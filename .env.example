# llama-server (or any OpenAI-compatible server exposing logprobs + logit_bias)
QEV_UPSTREAM=http://127.0.0.1:8000
# QEV_UPSTREAM_API_KEY=replace-if-upstream-requires-bearer-auth

# Optional model filter; when unset QEv uses the first model listed by upstream /v1/models.
QEV_UPSTREAM_MODEL=

# Optional: require clients of QEv to send this as a Bearer token.
# QEV_API_KEY=local-dev-key

# Readout dialect. "llamacpp" expects llama.cpp token-string logit_bias keys and its
# OpenAI-style logprobs; "vllm", "sglang", and "openai" expect OpenAI-spec token-ID
# logit_bias keys and legacy completions logprobs. Images/audio require a chat path
# (audio: vllm/sglang/openai only).
QEV_BACKEND=llamacpp
# Send chat_template_kwargs {"enable_thinking": false} on chat (media) reads.
QEV_DISABLE_THINKING=false

QEV_HOST=127.0.0.1
QEV_PORT=8081
QEV_TIMEOUT=60
QEV_MAX_INFLIGHT=4
QEV_MAX_QUEUE=64

# Same additive logit_bias applied to every label token (logprob differences cancel it).
QEV_LABEL_BIAS=10
# Top-K size requested from upstream logprobs.
QEV_LOGPROBS_K=64
# Average reversed-label reads by default (2x cost; request field "permute" overrides).
QEV_PERMUTE_DEFAULT=false
